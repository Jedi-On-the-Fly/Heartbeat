{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heartbeat.local/dag.schema.json",
  "title": "HeartBeat DAG",
  "description": "Schema for a HeartBeat .hb/dag.json — phases, tasks, dependencies, and quality gates. Reference it from your dag.json with \"$schema\": \"../path/to/dag.schema.json\" for live editor validation.",
  "type": "object",
  "required": ["gates", "phases"],
  "properties": {
    "$schema": { "type": "string" },
    "_meta": { "type": "object" },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["criteria"],
        "properties": {
          "desc": { "type": "string" },
          "review": {
            "type": "object",
            "description": "Optional adversarial review — the phase advances only after a second agent fails to refute completion.",
            "properties": {
              "prompt": { "type": "string" },
              "constraints": {
                "type": "array",
                "description": "Plan-time constraints: falsifiable claims the refuter must answer one by one (VIOLATED / NOT-REPRODUCED / N/A). Ids P<n>; G<n> is reserved for constraints authored at review time.",
                "items": {
                  "type": "object",
                  "required": ["id", "claim", "subjects", "violation"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^P[0-9]+$" },
                    "claim": { "type": "string", "minLength": 1 },
                    "subjects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                    "violation": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "cmd"],
              "properties": {
                "id": { "type": "string" },
                "desc": { "type": "string" },
                "cmd": { "type": "string", "description": "One-line bash, exit 0 = pass. $PROJECT_DIR and $HB_DIR are available." },
                "timeout_s": { "type": "integer", "minimum": 1, "description": "Per-criterion timeout in seconds — WINS over the runner default (GATE_TIMEOUT_S, 60). An invalid value fails the criterion loudly at runtime." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tasks"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "gate_entry": { "type": ["string", "null"] },
          "gate_exit": { "type": ["string", "null"] },
          "parked": { "type": "boolean", "description": "Out of the plan's live surface: the resolver never offers its tasks, audit skips its gate, the --all sweep skips it (even if armed), and report lists it as parked. Set via `hb park <PHASE|GATE>`; reversible with `hb unpark`. Parking, not deletion — deleting a gate dangles gate_exit." },
          "parked_reason": { "type": "string" },
          "tasks": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "requires": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
